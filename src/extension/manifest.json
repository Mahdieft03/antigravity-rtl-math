{
  "manifest_version": 3,
  "name": "Antigravity RTL + Math",
  "description": "Smart Right-to-Left layout & Math Isolation (KaTeX, MathJax, MathML) for Antigravity Remote Control in the browser.",
  "version": "3.0.0",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://antigravity.static.usercontent.goog/web/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Vazirmatn-Variable.woff2"],
      "matches": ["https://antigravity.static.usercontent.goog/*"]
    }
  ]
}
